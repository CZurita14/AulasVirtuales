# Copiar a .env y ajustar. No poner tokens de Canvas aquí: cada docente lo ingresa en la pantalla.
QWEN_URL=http://172.16.8.69:8000/v1
QWEN_MODEL=Qwen/Qwen3-8B-AWQ
QWEN_TIMEOUT=120
IA_ACTIVA=1
IA_PARALELO=6
# Historial de cargas (botón "Historial"). En tu equipo funciona sin clave.
# EN UN SERVIDOR (detrás de nginx) el historial queda CERRADO hasta que definas HISTORIAL_CLAVE; o apágalo con HISTORIAL=0.
HISTORIAL=1
HISTORIAL_CLAVE=
# Sin clave el historial está CERRADO. En tu propio equipo (no en un servidor) puedes abrirlo sin clave con 1:
HISTORIAL_LOCAL=0
